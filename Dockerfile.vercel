# Vercel Container Runtime build for the existing Java/Tomcat application.
# Vercel routes all traffic to this container and sets PORT (80 by default).
FROM maven:3.9.6-eclipse-temurin-21 AS build
WORKDIR /app

COPY pom.xml .
RUN mvn dependency:go-offline -B
COPY src ./src
RUN mvn clean package -DskipTests -B

FROM tomcat:10.1-jdk21-temurin
RUN rm -rf /usr/local/tomcat/webapps/* && mkdir -p /tmp/contractiq-uploads
COPY --from=build /app/target/ContractIQ.war /usr/local/tomcat/webapps/ROOT.war

# UPLOAD_DIR is intentionally ephemeral here. Set a durable object-storage
# integration before relying on retained source PDFs in a deployed environment.
ENV UPLOAD_DIR=/tmp/contractiq-uploads
# Vercel rejects request bodies above 4.5 MB before they reach Tomcat. Keep
# the application limit below that platform limit (including multipart overhead).
ENV MAX_FILE_SIZE_MB=4
ENV APP_ENV=production
ENV PORT=80
EXPOSE 80

CMD ["sh", "-c", "sed -i \"s/port=\\\"8080\\\"/port=\\\"${PORT}\\\"/\" /usr/local/tomcat/conf/server.xml && exec catalina.sh run"]
