# ==============================================================================
# CONTRACTIQ CONFIGURATION ENVIRONMENT VARIABLES
# Copy this file to .env and replace the placeholder values.
# NEVER commit the real .env file or credentials to version control.
# ==============================================================================

# Database Configuration (MySQL 8+)
DB_URL=jdbc:mysql://localhost:3306/contractiq_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_POOL_SIZE=10

# Application Server Configuration
PORT=8080
APP_ENV=development
APP_BASE_URL=http://localhost:8080/ContractIQ

# Uploads and Storage
UPLOAD_DIR=E:/ContractIQ/uploads
MAX_FILE_SIZE_MB=15

# Real AI / LLM Configuration
# Supports OpenAI, Azure OpenAI, OpenRouter, Groq, Ollama, Google Gemini OpenAI-compatible endpoints
# Example OpenAI: https://api.openai.com/v1/chat/completions
# Example Groq: https://api.groq.com/openai/v1/chat/completions
# Example OpenRouter: https://openrouter.ai/api/v1/chat/completions
LLM_API_KEY=your_openai_or_groq_api_key_here
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
# Set to true to force deterministic mock extractor even if API key is present (useful for offline tests)
DEMO_MODE=false
